# Database
DATABASE_URL=postgresql+psycopg2://hms:hms@localhost:5432/hms

# Auth
# JWT signing keyring (replaces bare SECRET_KEY for token signing). Keep
# retired kids in the map until every refresh token signed with them has
# expired, then remove — see PRPs/auth-rbac-abac-prp.md Security Design 1.
JWT_SIGNING_KEYS={"k1":"generate-with-openssl-rand-base64-32"}
JWT_CURRENT_KID=k1
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# HMAC key for deterministic PHI-matching hashes (core/encryption.py). Keep
# this separate from JWT_SIGNING_KEYS — rotating JWT keys must never change
# the hash of an already-stored phone/national-id.
HMAC_KEY=generate-a-separate-key-do-not-reuse-jwt-keys

# Rate limiting (core/rate_limit.py) — login endpoints, per-email and per-IP
LOGIN_RATE_LIMIT_PER_MINUTE=5
LOGIN_IP_RATE_LIMIT_PER_MINUTE=20

# PHI field-level encryption — generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PHI_ENCRYPTION_KEY=

# Redis (distributed locking)
REDIS_URL=redis://localhost:6379/0
REDIS_LOCK_TTL_MS=5000

# RabbitMQ (event bus)
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
EVENTS_EXCHANGE=hms.events

# Frontend
VITE_API_URL=http://localhost:8000
FRONTEND_ORIGIN=http://localhost:3000
